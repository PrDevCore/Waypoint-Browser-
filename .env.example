# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Authentication (required in production)
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true

# Hosted web/mobile clients (comma-separated origins)
CORS_ORIGINS=https://app.example.com,capacitor://localhost,http://localhost

# Mobile web build API endpoint
# For local mobile testing, replace 192.168.1.X with your computer's LAN IP:
VITE_API_BASE=http://192.168.1.X:3000

# SQLite persistence
DB_PATH=/data/app.db


# BROWSER_MAX_SESSIONS: Max concurrent Playwright browser sessions (default 5).
# BROWSER_MAX_SESSIONS=5

# BROWSER_NO_SANDBOX: Set to 1 only inside a Docker container that is itself
# isolated at the network/OS level. Never set this on a bare host.
# BROWSER_NO_SANDBOX=0

# Windows code signing (release builds only).
# CSC_LINK=C:\Certificates\Waypoint-signing.pfx
# CSC_KEY_PASSWORD=your-certificate-password
