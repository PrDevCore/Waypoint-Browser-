{
  "name": "waypoint-browser-workspace",
  "private": true,
  "version": "1.0.0",
  "author": "pr dev core tech",
  "license": "MIT",
  "description": "Waypoint Browser and Team Workspace desktop application",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:electron": "npm run build && electron .",
    "build": "vite build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "sign:cert": "scripts\\generate-signing-cert.cmd",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win",
    "package": "npm run build && electron-builder",
    "preview": "vite preview",
    "clean": "Remove-Item -Recurse -Force dist, dist-electron -ErrorAction SilentlyContinue",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test server/app.test.ts",
    "test:electron": "npm run build && node scripts/electron-smoke.mjs",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "mobile:add": "npx cap add android && npx cap add ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "electron": "45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "forceCodeSigning": true,
    "appId": "com.example.waypoint",
    "productName": "Waypoint",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist-electron/**",
      "dist/**",
      "public/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/waypoint-icon.svg",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "signingHashAlgorithms": ["sha256"],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    }
  }
}
